{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "mambo-point",
          "appId": "1:624779079622:android:447708dac8a2d81b4e8cc7",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "mambo-point",
          "configurations": {
            "android": "1:624779079622:android:447708dac8a2d81b4e8cc7",
            "ios": "1:624779079622:ios:7800a93c8888d82e4e8cc7",
            "macos": "1:624779079622:ios:7800a93c8888d82e4e8cc7",
            "web": "1:624779079622:web:93c6d438eeda48374e8cc7",
            "windows": "1:624779079622:web:204711951ee29ee34e8cc7"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
